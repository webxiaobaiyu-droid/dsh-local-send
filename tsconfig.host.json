{
  // Host half: the Cordis plugin loaded inside the dsh process plus the pure
  // protocol modules it owns.
  //
  // Split from the browser half on purpose. Both halves merge the Cordis
  // `Context` under the same keys with different services, so one TypeScript
  // program cannot see both — the harness splits its own typecheck the same
  // way (`tsconfig.host.json` / `tsconfig.client.json` at its root).
  "extends": "./tsconfig.json",
  "include": [
    "src/index.ts",
    "src/types.ts",
    "src/protocol.ts",
    "src/discovery.ts",
    "src/outbound.ts",
    "src/transfer.ts",
    "src/server.ts",
    "src/store.ts",
    "tests/*.host.spec.ts"
  ]
}
